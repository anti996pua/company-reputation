# GitHub 多账号配置模板
# 复制为 .env 并填入实际 token（.env 已被 .gitignore 忽略）
#
# GITHUB_TOKEN:      用于 GitHub API + gh CLI + opencode github MCP
# GITHUB_ACCOUNT:    账号名（用于 gitconfig includeIf）
#
# 查看已配置的账号：ls ~/.config/github/*.token
# 切换账号：export GITHUB_TOKEN=$(cat ~/.config/github/ACCOUNT_NAME.token)

# 当前项目使用的 GitHub 账号
GITHUB_ACCOUNT=work
GITHUB_TOKEN=ghp_your_token_here
GITHUB_USER=appotry
GITHUB_EMAIL=andycrusoe@gmail.com
