  "giscus": {
    "repo": "",
    "repoId": "",
    "category": "",
    "categoryId": ""
  },
  "devServer": {
    "host": "127.0.0.1",
    "port": 8080
  },
  "branches": {
    "develop": {
      "description": "开发分支 — 功能开发与Bug修复",
      "allowedChanges": "all",
      "deployTarget": "none"
    },
    "data": {
      "description": "数据贡献分支 — 用户添加公司/部门/职位",
      "allowedChanges": "companies/*.md only",
      "deployTarget": "none"
    },
    "main": {
      "description": "展示分支 — 生产环境",
      "allowedChanges": "merge only from data",
      "deployTarget": "pages + docker"
    }
  }
